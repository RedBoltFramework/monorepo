<Project>
  <PropertyGroup>
    <RedBoltWebSamplesRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltWebSamplesRoot>
    <RedBoltRoot>$(RedBoltWebSamplesRoot)/RedBolt</RedBoltRoot>
    <RedBoltPlatform>browser-wasm</RedBoltPlatform>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/src/Directory.Build.props" />
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Sample.props" />
  <PropertyGroup>
    <RedBoltWebBundle Condition="'$(RedBoltWebBundle)' == ''">standard</RedBoltWebBundle>
    <BaseIntermediateOutputPath>$(RedBoltIntermediateRoot)/$(MSBuildProjectName)/$(RedBoltWebBundle)/</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(RedBoltRoot)/build/obj/restore/browser-wasm/$(MSBuildProjectName)/$(RedBoltWebBundle)/</MSBuildProjectExtensionsPath>
    <OutputPath>$(RedBoltIntermediateRoot)/staging/$(MSBuildProjectName)/$(RedBoltWebBundle)/$(Configuration)/</OutputPath>
  </PropertyGroup>
</Project>
