<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <RedBoltWebBundle Condition="'$(RedBoltWebBundle)' == ''">standard</RedBoltWebBundle>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RedBoltWebProgram>$(MSBuildThisFileDirectory)/BundleProgram.cs</RedBoltWebProgram>
    <RedBoltWebOutputDir>$(RedBoltWebSamplesRoot)/build/bin/$(Configuration)/browser-wasm/web/$(RedBoltWebBundle)</RedBoltWebOutputDir>
    <RedBoltExternalWebPInvokeModules>RedBolt.Native.DearImGui;RedBolt.Native.TinyGltf</RedBoltExternalWebPInvokeModules>
    <RedBoltWebExtensionScript Condition="'$(RedBoltWebBundle)' == 'standard' or '$(RedBoltWebBundle)' == 'physics-jolt'">$(RedBoltWebSamplesRoot)/RedBolt.Network/src/RedBolt/Sample/Web/wwwroot/extension.js</RedBoltWebExtensionScript>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RedBoltWebBundle)' == 'physics-box2d'">
    <RedBoltExternalWebArchive>$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/build/native/browser-wasm/lib/Release/wasm/RedBolt.PhysicsBox2D.Native.Web.a</RedBoltExternalWebArchive>
    <RedBoltExternalWebPInvokeModules>$(RedBoltExternalWebPInvokeModules);RedBolt.Native.Box2D</RedBoltExternalWebPInvokeModules>
    <RedBoltExternalModuleRoot>$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.PhysicsBox2D</RedBoltExternalModuleName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RedBoltWebBundle)' == 'physics-jolt'">
    <RedBoltExternalWebArchive>$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/build/native/browser-wasm/lib/Release/wasm/RedBolt.PhysicsJolt.Native.Web.a</RedBoltExternalWebArchive>
    <RedBoltExternalWebPInvokeModules>$(RedBoltExternalWebPInvokeModules);RedBolt.Native.Jolt</RedBoltExternalWebPInvokeModules>
    <RedBoltExternalModuleRoot>$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.PhysicsJolt</RedBoltExternalModuleName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RedBoltWebBundle)' == 'rmlui'">
    <RedBoltExternalWebArchive>$(RedBoltWebSamplesRoot)/RedBolt.RmlUI/build/native/browser-wasm/lib/Release/wasm/RedBolt.RmlUI.Native.Web.a</RedBoltExternalWebArchive>
    <RedBoltExternalWebPInvokeModules>$(RedBoltExternalWebPInvokeModules);RedBolt.Native.RmlUi</RedBoltExternalWebPInvokeModules>
    <RedBoltExternalModuleRoot>$(RedBoltWebSamplesRoot)/RedBolt.RmlUI</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.RmlUI</RedBoltExternalModuleName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/Audio/RedBolt.Audio.csproj" />
    <ProjectReference Include="$(RedBoltRoot)/src/RedBolt/DearImGui/RedBolt.DearImGui.csproj" />
    <Content Include="$(RedBoltRoot)/src/RedBolt/Sample/Web/wwwroot/index.html" Link="wwwroot/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RedBoltWebBundle)' == 'standard'">
    <ProjectReference Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/2D/RedBolt.2D.csproj;$(RedBoltWebSamplesRoot)/RedBolt.Actions/src/RedBolt/Actions/RedBolt.Actions.csproj;$(RedBoltWebSamplesRoot)/RedBolt.CSG/src/RedBolt/CSG/RedBolt.CSG.csproj;$(RedBoltWebSamplesRoot)/RedBolt.IK/src/RedBolt/IK/RedBolt.IK.csproj;$(RedBoltWebSamplesRoot)/RedBolt.Navigation/src/RedBolt/Navigation/RedBolt.Navigation.csproj;$(RedBoltWebSamplesRoot)/RedBolt.Network/src/RedBolt/Network/RedBolt.Network.csproj;$(RedBoltWebSamplesRoot)/RedBolt.Particles/src/RedBolt/Particles/RedBolt.Particles.csproj" />
    <Compile Include="$(RedBoltRoot)/src/RedBolt/Sample/**/*.cs" Exclude="$(RedBoltRoot)/src/RedBolt/Sample/Android/**/*.cs;$(RedBoltRoot)/src/RedBolt/Sample/Web/**/*.cs;$(RedBoltRoot)/src/RedBolt/Sample/WebRTCSTUN/**/*.cs" Link="Samples/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/Sample/Urho2DParticle/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/Sample/Urho2DSprite/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/Sample/Urho2DSpriterAnimation/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/Sample/Urho2DStretchableSprite/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/Sample/Urho2DTileMap/**/*.cs" Link="Samples/2D/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(RedBoltWebSamplesRoot)/RedBolt.Actions/src/RedBolt/Sample/Actions/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.CSG/src/RedBolt/Sample/CSG/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.IK/src/RedBolt/Sample/InverseKinematics/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.Navigation/src/RedBolt/Sample/CrowdNavigation/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.Navigation/src/RedBolt/Sample/Navigation/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.Network/src/RedBolt/Sample/Chat/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.Network/src/RedBolt/Sample/HttpRequestDemo/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.Network/src/RedBolt/Sample/LANDiscovery/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.Particles/src/RedBolt/Sample/Particles/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootAssembly Include="RedBolt.2D;RedBolt.Actions;RedBolt.CSG;RedBolt.IK;RedBolt.Navigation;RedBolt.Network;RedBolt.Particles" />
    <RedBoltWebCoreDataResource Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/bin/CoreData/**/*" />
    <RedBoltWebDataResource Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/bin/Data/**/*;$(RedBoltWebSamplesRoot)/RedBolt.IK/bin/Data/**/*" />
  </ItemGroup>

  <ItemGroup Condition="'$(RedBoltWebBundle)' == 'physics-box2d'">
    <ProjectReference Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/src/RedBolt/2D/RedBolt.2D.csproj;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/PhysicsBox2D/RedBolt.PhysicsBox2D.csproj" />
    <Compile Include="$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/Sample/Physics2D/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/Sample/Physics2DConstraints/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/Sample/Physics2DRope/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/Sample/Urho2DIsometricDemo/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/Sample/Urho2DPlatformer/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsBox2D/src/RedBolt/Sample/Utilities2D/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootAssembly Include="RedBolt.2D;RedBolt.PhysicsBox2D" />
    <RedBoltWebCoreDataResource Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/bin/CoreData/**/*" />
    <RedBoltWebDataResource Include="$(RedBoltWebSamplesRoot)/RedBolt.2D/bin/Data/**/*" />
  </ItemGroup>

  <ItemGroup Condition="'$(RedBoltWebBundle)' == 'physics-jolt'">
    <ProjectReference Include="$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/PhysicsJolt/RedBolt.PhysicsJolt.csproj;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/PhysicsJolt.Network/RedBolt.PhysicsJolt.Network.csproj;$(RedBoltWebSamplesRoot)/RedBolt.Network/src/RedBolt/Network/RedBolt.Network.csproj" />
    <Compile Include="$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/Sample/AdvancedNetworking/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/Sample/CharacterDemo/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/Sample/KinematicCharacter/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/Sample/Physics/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/Sample/RaycastVehicle/**/*.cs;$(RedBoltWebSamplesRoot)/RedBolt.PhysicsJolt/src/RedBolt/Sample/SceneReplication/**/*.cs" Link="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootAssembly Include="RedBolt.Network;RedBolt.PhysicsJolt;RedBolt.PhysicsJolt.Network" />
  </ItemGroup>

  <ItemGroup Condition="'$(RedBoltWebBundle)' == 'rmlui'">
    <ProjectReference Include="$(RedBoltWebSamplesRoot)/RedBolt.RmlUI/src/RedBolt/RmlUI/RedBolt.RmlUI.csproj" />
    <Compile Include="$(RedBoltWebSamplesRoot)/RedBolt.RmlUI/src/RedBolt/Sample/AdvancedUI/**/*.cs" Link="Samples/AdvancedUI/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(RedBoltWebSamplesRoot)/RedBolt.RmlUI/src/RedBolt/Sample/HelloRmlUI/**/*.cs" Link="Samples/HelloRmlUI/%(RecursiveDir)%(Filename)%(Extension)" />
    <TrimmerRootAssembly Include="RedBolt.RmlUI;RedBolt.Bindings.RmlUi" />
    <RedBoltWebCoreDataResource Include="$(RedBoltWebSamplesRoot)/RedBolt.RmlUI/bin/CoreData/**/*" />
    <RedBoltWebDataResource Include="$(RedBoltWebSamplesRoot)/RedBolt.RmlUI/bin/Data/**/*" />
  </ItemGroup>

  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/WebSample.targets" />
</Project>
