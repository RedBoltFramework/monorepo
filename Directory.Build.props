<Project>
  <!--
    Marks the monorepo root. RedBolt/eng/RedBolt.Layout.props imports this file.
    The build root is build/ beside the engine.
  -->
  <PropertyGroup>
    <RedBoltMonorepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RedBoltMonorepoRoot>
  </PropertyGroup>
</Project>
